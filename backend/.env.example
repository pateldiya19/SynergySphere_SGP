# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Every value below that reads GENERATE_ME or FILL_ME is deliberately NOT a
# working default: src/config/index.ts rejects placeholder and short secrets at
# startup, so the server refuses to boot rather than signing sessions with a
# value that is published in this repository.
#
# Generate each secret separately -- never reuse one across variables:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/synergysphere
MONGODB_TEST_URI=mongodb://localhost:27017/synergysphere_test

# JWT -- required. Must be at least 32 characters and must differ from each
# other, so a stolen access token cannot be replayed as a refresh token.
JWT_SECRET=GENERATE_ME
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=GENERATE_ME
JWT_REFRESH_EXPIRE=30d

# Email delivery (optional -- invitations and review requests fall back to
# in-app notifications when unset). Use an app password, not your account
# password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=FILL_ME
SMTP_PASSWORD=FILL_ME

# Attachment storage (optional -- uploads return 503 when unset)
CLOUDINARY_CLOUD_NAME=FILL_ME
CLOUDINARY_API_KEY=FILL_ME
CLOUDINARY_API_SECRET=FILL_ME

# CORS
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# GitHub identity verification (optional -- leaving both unset disables account
# linking, and author verification then stays permanently indeterminate).
#
# Create at: GitHub -> Settings -> Developer settings -> OAuth Apps -> New.
#   Homepage URL:              http://localhost:5173
#   Authorization callback URL: must equal GITHUB_OAUTH_CALLBACK_URL below,
#                               byte for byte, or GitHub refuses the exchange.
#
# No scopes are requested: only the public profile (id, login, avatar) is read,
# and the access token is discarded immediately after, never stored.
GITHUB_OAUTH_CLIENT_ID=FILL_ME
GITHUB_OAUTH_CLIENT_SECRET=FILL_ME
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# GitHub proof-of-work webhook (optional -- leaving it unset disables GitHub
# evidence ingestion entirely, which is safe; a WEAK value is not, because it
# lets anyone forge commit evidence against a task).
#
# This exact string must also be pasted into the repository's webhook settings:
# GitHub repo -> Settings -> Webhooks -> Secret.
GITHUB_WEBHOOK_SECRET=GENERATE_ME
GITHUB_WEBHOOK_URL=http://localhost:5000/api/github/webhook
