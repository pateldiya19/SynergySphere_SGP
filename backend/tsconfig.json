{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@/models": ["./app/models/index"],
      "@/routes": ["./infrastructure/routes/index"],
      "@/middleware": ["./core/middleware/index"],
      "@/utils": ["./core/utils/index"],
      "@/config": ["./config/index"],
      "@/controllers/*": ["./app/controllers/*"],
      "@/models/*": ["./app/models/*"],
      "@/routes/*": ["./infrastructure/routes/*"],
      "@/middleware/*": ["./core/middleware/*"],
      "@/utils/*": ["./core/utils/*"],
      "@/config/*": ["./config/*"],
      "@/types/*": ["./types/*"],
      "@/services/*": ["./app/services/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
