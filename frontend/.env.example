# Base URL of the SynergySphere backend API.
# Must match the backend's PORT; vite.config.ts also proxies /api to this host.
VITE_API_BASE_URL=http://localhost:8000

# Socket.io endpoint for live task, discussion and notification updates.
VITE_WS_URL=http://localhost:8000

VITE_APP_NAME=SynergySphere

# Serve mocked API responses instead of calling the backend. Keep false.
VITE_USE_MOCKS=false
